generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Raffle {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  drawDate    DateTime?
  status      RaffleStatus @default(ACTIVE)
  createdAt   DateTime @default(now())

  numbers     RaffleNumber[]
  purchases   Purchase[]
}

model RaffleNumber {
  id                   String   @id @default(cuid())
  raffleId             String
  number               Int
  status               NumberStatus @default(AVAILABLE)
  reservationExpiresAt DateTime?

  raffle               Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  
  purchaseId           String?
  purchase             Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@unique([raffleId, number])
}

model Purchase {
  id          String   @id @default(cuid())
  raffleId    String
  buyerName   String
  buyerPhone  String
  totalAmount Decimal  @db.Decimal(10, 2)
  status      PurchaseStatus @default(PENDING)
  createdAt   DateTime @default(now())
  paidAt      DateTime?

  raffle      Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  numbers     RaffleNumber[]
}

enum RaffleStatus {
  ACTIVE
  DRAWN
  CANCELLED
}

enum NumberStatus {
  AVAILABLE
  RESERVED
  PAID
  CANCELLED
}

enum PurchaseStatus {
  PENDING
  PAID
  CANCELLED
}
